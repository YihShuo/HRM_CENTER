            strSQL = strSQL + " HESOMOI = 0,"
            strSQL = strSQL + " HESOCU = ST_DIENBIENLUONG.DBL_Heso,"
            strSQL = strSQL + " PHUCAPMOI = 0,"
            strSQL = strSQL + " PHUCAPCU = ST_DIENBIENLUONG.DBL_PhuCap"
            strSQL = strSQL + " FROM"
            strSQL = strSQL + " "
            strSQL = strSQL + " (SELECT NV_MA , NGAY = MAX(DBL_Ngaybatdau) FROM ST_DIENBIENLUONG"
            strSQL = strSQL + " WHERE CONVERT(CHAR(10),DBL_Ngaybatdau,103)+NV_MA NOT IN ("
            strSQL = strSQL + " SELECT CONVERT(CHAR(10),V1.NGAY,103)+V1.NV_MA"
            strSQL = strSQL + " FROM "
            strSQL = strSQL + " ("
            strSQL = strSQL + " SELECT NV_MA,NGAY=MAX(DBL_Ngaybatdau)"
            strSQL = strSQL + " FROM ST_DIENBIENLUONG"
            strSQL = strSQL + " GROUP BY NV_MA"
            strSQL = strSQL + " ) AS V1"
            strSQL = strSQL + " INNER JOIN ST_DIENBIENLUONG ON V1.NV_MA = ST_DIENBIENLUONG.NV_MA AND V1.NGAY = ST_DIENBIENLUONG.DBL_NGAYBATDAU)"
            strSQL = strSQL + " GROUP BY NV_MA"
            strSQL = strSQL + " ) AS V3"
            strSQL = strSQL + " INNER JOIN ST_DIENBIENLUONG ON V3.NV_MA = ST_DIENBIENLUONG.NV_MA AND V3.NGAY = ST_DIENBIENLUONG.DBL_NGAYBATDAU"
            strSQL = strSQL + " WHERE V3.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC)"
            strSQL = strSQL + " UNION"
            strSQL = strSQL + " SELECT "
            strSQL = strSQL + " V1.NV_MA,"
            strSQL = strSQL + " NGAYMOI=V1.NGAY,"
            strSQL = strSQL + " NGAYCU=0,"
            strSQL = strSQL + " LUONGMOI=ST_DIENBIENLUONG.DBL_LuongCB,"
            strSQL = strSQL + " LUONGCU=0, "
            strSQL = strSQL + " QDMOI = ST_DIENBIENLUONG.DBL_Soquyetdinh,"
            strSQL = strSQL + " QDCU = '0',"
            strSQL = strSQL + " HESOMOI = ST_DIENBIENLUONG.DBL_Heso,"
            strSQL = strSQL + " HESOCU = 0,"
            strSQL = strSQL + " PHUCAPMOI =ST_DIENBIENLUONG.DBL_PhuCap,"
            strSQL = strSQL + " PHUCAPCU = 0"
            strSQL = strSQL + " FROM (SELECT NV_MA,NGAY=MAX(DBL_NGAYBATDAU)"
            strSQL = strSQL + " FROM ST_DIENBIENLUONG"
            strSQL = strSQL + " GROUP BY NV_MA) AS V1"
            strSQL = strSQL + " INNER JOIN ST_DIENBIENLUONG ON V1.NV_MA = ST_DIENBIENLUONG.NV_MA AND V1.NGAY = ST_DIENBIENLUONG.DBL_NGAYBATDAU"
            strSQL = strSQL + " WHERE V1.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC)) AS V4"
            strSQL = strSQL + " GROUP BY NV_MA) AS V5"
            strSQL = strSQL + " INNER JOIN ST_NHANVIEN ON ST_NHANVIEN.NV_MA = V5.NV_MA"
            strSQL = strSQL + " INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA INNER JOIN ST_HOPDONGLAODONG ON ST_HOPDONGLAODONG.NV_MA = V5.NV_MA"
            strSQL = strSQL + " WHERE (Month(NGAYMOI) = MONTH('" & Me.QuoteString(obj.NGAY) & "') And Year(NGAYMOI) =  Year('" & Me.QuoteString(obj.NGAY) & "'))"
            strSQL = strSQL + " AND  V5.NV_MA IN (SELECT NV_MA FROM ST_HOPDONGLAODONG WHERE MONTH(ST_HOPDONGLAODONG.HD_NGAYKY) = MONTH('" & Me.QuoteString(obj.NGAY) & "') AND ST_HOPDONGLAODONG.L_MA = '1')"
            strSQL = strSQL + " AND ST_NHANVIEN.DV_MA = '" & Me.QuoteString(obj.DonVi) & "'"
            strSQL = strSQL + " AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC)"
            strSQL = strSQL + " AND ST_NHANVIEN.DV_MA NOT LIKE 'NV%'"
            strSQL = strSQL + " GROUP BY V5.NV_MA,"
            strSQL = strSQL + " ST_NHANVIEN.NV_TEN,"
            strSQL = strSQL + " ST_NHANVIEN.DV_MA,"
            strSQL = strSQL + " ST_NHANVIEN.NV_NGAYVAO"
        End If

        
        'Thuc thi cau truy van
        Try
            table = Me.getTableSQL(strSQL)
        Catch exception1 As Exception
            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message)
            table = Nothing
            ProjectData.ClearProjectError()
        End Try
        Return table
    End Function
    Public Function GoiThuTucLoadDS(ByVal m_sSP_Name As String, ByVal m_listpar As ArrayList) As DataTable
        Return Me.getDatasetProcedure(m_sSP_Name, m_listpar).Tables(0)
    End Function
End Class
