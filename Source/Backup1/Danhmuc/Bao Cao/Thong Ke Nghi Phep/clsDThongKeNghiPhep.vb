
Imports System
Imports System.Data
Imports System.Windows.Forms
Imports Microsoft.VisualBasic.CompilerServices
Public Class clsDThongKeNghiPhep
    Inherits DALSQL

    Public Function QuoteString(ByVal s As String) As String
        Return s.Replace("'", "''")
    End Function

    Public Function LoadDS(ByVal obj As objThongKeNghiPhep) As DataTable
        Dim table As DataTable
        Dim strSQL As String = ""

        If (StringType.StrCmp(obj.ID, "", False) <> 0) Then
            strSQL = (strSQL & "where DV_MA = N'" & Me.QuoteString(obj.ID) & "'")
        End If

        If obj.ChonBang = 1 Then
            strSQL = ("select * from " & Me.QuoteString(obj.Table) & " " & strSQL & " order by NV_Ma asc")
        End If

        'Cau truy van load Tuan len combo Tuan
        If obj.ChonBang = 2 Then
            strSQL = ("SELECT DV_MA FROM ST_DONVI WHERE DV_MA <> ' ' ORDER BY DV_MA ASC ")
        End If

        If obj.ChonBang = 3 Then
            strSQL = ("SELECT ST_NHANVIEN.NV_TEN AS NV_TEN,ST_NHANVIEN.NV_MA AS NV_MA,ST_CONGVIEC.CV_TEN AS CV_TEN,ST_DONVI.DV_MA AS DV_MA,ST_PHEPNAM.PN_SONGAYNAMTRUOC AS PN_SONGAYNAMTRUOC,ST_PHEPNAM.PN_SONGAYNAMNAY AS PN_SONGAYNAMNAY,(CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END) AS PHEPNAMDOCHAI ,(CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO, '" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END) AS PHEPNAMTHAMNIEN ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'P' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS P ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'R' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105)<= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS R ,SUM (CASE WHEN  ST_GIOQUETTHE.NP_MA = 'RO' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS RO ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'OM' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS OM   ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'CO' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS CO ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'OP' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS OP ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'NO' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS NO,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'KTHAI' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS KT,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'TS' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS TS ,(ST_PHEPNAM.PN_SONGAYNAMTRUOC	+ ST_PHEPNAM.PN_SONGAYNAMNAY  + (CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO, '" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END) + (CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END)) - ST_PHEPNAM.PN_SONGAYDANGHI AS SONGAYCONLAI FROM ST_NHANVIENNGHIPHEP INNER JOIN ST_GIOQUETTHE ON (ST_GIOQUETTHE.NV_MA = ST_NHANVIENNGHIPHEP.NV_MA AND ST_GIOQUETTHE.NP_MA = ST_NHANVIENNGHIPHEP.NP_MA AND( ST_GIOQUETTHE.QT_NGAY between ST_NHANVIENNGHIPHEP.NP_TUNGAY  and  ST_NHANVIENNGHIPHEP.NP_DENNGAY) )INNER JOIN ST_NHANVIEN ON ST_NHANVIEN.NV_MA = ST_GIOQUETTHE.NV_MA  INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_PHEPNAM  ON ST_PHEPNAM.NV_MA = ST_NHANVIEN.NV_MA    WHERE NOT ST_DONVI.X_MA_ IS NULL AND  ST_DONVI.DV_MA NOT LIKE '%CG%' AND  ST_DONVI.DV_MA NOT IN ('NV,NV01') AND NOT ST_DONVI.DV_MA = 'BGD' AND  ST_DONVI.DV_MA NOT LIKE 'DT%' AND NOT ST_DONVI.DV_MA = 'TVKTX' AND ST_PHEPNAM.PN_NAM ='2009' AND YEAR(ST_GIOQUETTHE.QT_NGAY) ='2009' AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_NHANVIEN.DV_MA =N'" & Me.QuoteString(obj.DonVi) & "' GROUP BY ST_NHANVIEN.NV_TEN,ST_NHANVIEN.NV_MA,ST_CONGVIEC.CV_TEN,ST_DONVI.DV_MA,ST_PHEPNAM.PN_SONGAYNAMTRUOC,ST_PHEPNAM.PN_SONGAYNAMNAY,(CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END),(CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO, '" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END),(ST_PHEPNAM.PN_SONGAYNAMTRUOC + ST_PHEPNAM.PN_SONGAYNAMNAY + (CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO,'" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END) + (CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END)) - ST_PHEPNAM.PN_SONGAYDANGHI ")
        End If

        If obj.ChonBang = 5 Then
            strSQL = ("SELECT ST_NHANVIEN.NV_TEN AS NV_TEN,ST_NHANVIEN.NV_MA AS NV_MA,ST_CHUCVU.CVU_TEN AS CVU_TEN,ST_DONVI.DV_MA AS DV_MA,ST_PHEPNAM.PN_SONGAYNAMTRUOC AS PN_SONGAYNAMTRUOC,ST_PHEPNAM.PN_SONGAYNAMNAY AS PN_SONGAYNAMNAY,(CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END) AS PHEPNAMDOCHAI ,(CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO, '" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END) AS PHEPNAMTHAMNIEN ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'P' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS P ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'R' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105)<= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS R ,SUM (CASE WHEN  ST_GIOQUETTHE.NP_MA = 'RO' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS RO ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'OM' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS OM   ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'CO' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS CO ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'OP' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS OP ,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'NO' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS NO,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'KTHAI' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS KT,SUM(CASE WHEN  ST_GIOQUETTHE.NP_MA = 'TS' AND ST_GIOQUETTHE.QT_NGAY >= ST_NHANVIENNGHIPHEP.NP_TUNGAY AND CONVERT(DATETIME,ST_GIOQUETTHE.QT_NGAY, 105) <= '" & Me.QuoteString(obj.NGAY) & "' THEN 1 ELSE 0 END) AS TS ,(ST_PHEPNAM.PN_SONGAYNAMTRUOC	+ ST_PHEPNAM.PN_SONGAYNAMNAY  + (CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO, '" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END) + (CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END)) - ST_PHEPNAM.PN_SONGAYDANGHI AS SONGAYCONLAI FROM ST_NHANVIENNGHIPHEP INNER JOIN ST_GIOQUETTHE ON (ST_GIOQUETTHE.NV_MA = ST_NHANVIENNGHIPHEP.NV_MA AND ST_GIOQUETTHE.NP_MA = ST_NHANVIENNGHIPHEP.NP_MA AND( ST_GIOQUETTHE.QT_NGAY between ST_NHANVIENNGHIPHEP.NP_TUNGAY  and  ST_NHANVIENNGHIPHEP.NP_DENNGAY) )INNER JOIN ST_NHANVIEN ON ST_NHANVIEN.NV_MA = ST_GIOQUETTHE.NV_MA  INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_PHEPNAM  ON ST_PHEPNAM.NV_MA = ST_NHANVIEN.NV_MA INNER JOIN ST_CHUCVU ON ST_NHANVIEN.CVU_MA = ST_CHUCVU.CVU_MA    WHERE NOT ST_DONVI.X_MA_ IS NULL AND  ST_DONVI.DV_MA NOT LIKE '%CG%' AND  ST_DONVI.DV_MA NOT IN ('NV,NV01') AND NOT ST_DONVI.DV_MA = 'BGD' AND  ST_DONVI.DV_MA NOT LIKE 'DT%' AND NOT ST_DONVI.DV_MA = 'TVKTX' AND ST_PHEPNAM.PN_NAM ='2009' AND YEAR(ST_GIOQUETTHE.QT_NGAY) ='2009' AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_NHANVIEN.CVU_MA =N'" & Me.QuoteString(obj.ChucVu) & "' GROUP BY ST_NHANVIEN.NV_TEN,ST_NHANVIEN.NV_MA,ST_CHUCVU.CVU_TEN,ST_DONVI.DV_MA,ST_PHEPNAM.PN_SONGAYNAMTRUOC,ST_PHEPNAM.PN_SONGAYNAMNAY,(CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END),(CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO, '" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END),(ST_PHEPNAM.PN_SONGAYNAMTRUOC + ST_PHEPNAM.PN_SONGAYNAMNAY + (CASE WHEN DATEDIFF(yy, ST_NHANVIEN.NV_NGAYVAO,'" & Me.QuoteString(obj.NGAY) & "') >= 5 AND MONTH(ST_NHANVIEN.NV_NGAYVAO) <=6 THEN 1 ELSE 0 END) + (CASE WHEN ST_CONGVIEC.CV_DOCHAI = 1 THEN 2 ELSE 0 END)) - ST_PHEPNAM.PN_SONGAYDANGHI ")
        End If

        If obj.ChonBang = 4 Then
            strSQL = ("SELECT CVU_MA, CVU_TEN FROM ST_CHUCVU WHERE CVU_MA <> ' ' ORDER BY CVU_MA ASC ")
        End If

        'Thuc thi cau truy van
        Try
            table = Me.getTableSQL(strSQL)
        Catch exception1 As Exception
            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message)
            table = Nothing
            ProjectData.ClearProjectError()
        End Try
        Return table
    End Function
End Class
