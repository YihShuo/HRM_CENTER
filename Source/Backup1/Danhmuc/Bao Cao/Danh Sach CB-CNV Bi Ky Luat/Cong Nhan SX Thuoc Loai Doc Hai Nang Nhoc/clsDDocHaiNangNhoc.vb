Imports Microsoft.VisualBasic.CompilerServices
Imports System
Imports System.Data
Imports System.Windows.Forms
Public Class clsDDocHaiNangNhoc
    Inherits DALSQL
    Public Function LoadDS(ByVal obj As objDocHaiNangNhoc) As DataTable
        Dim table As DataTable
        Dim strSQL As String = ""

        'Cau truy van load donvi len combo don vi
        If obj.ChonBang = 1 Then
            strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_DONVI.X_MA_= N'" & Me.QuoteString(obj.Xuong) & "'ORDER BY ST_NHANVIEN.NV_MA")
        End If
        If obj.ChonBang = 3 Then
            If obj.Khu = "TCT" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_DONVI.N_MA= N'" & Me.QuoteString(obj.Nganh) & "'ORDER BY ST_NHANVIEN.NV_MA")
            End If
            If obj.Khu = "KHUA" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_DONVI.N_MA= N'" & Me.QuoteString(obj.Nganh) & "' AND  ST_NHANVIEN.DV_MA  NOT LIKE N'B%' ORDER BY ST_NHANVIEN.NV_MA")

            End If
            If obj.Khu = "KHUB" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_DONVI.N_MA= N'" & Me.QuoteString(obj.Nganh) & "' AND  ST_NHANVIEN.DV_MA  LIKE N'B%' ORDER BY ST_NHANVIEN.NV_MA")

            End If
            If obj.Khu = "" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_DONVI.N_MA= N'" & Me.QuoteString(obj.Nganh) & "'ORDER BY ST_NHANVIEN.NV_MA")

            End If
        End If
        If obj.ChonBang = 4 Then
            strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_DONVI.DV_MA= N'" & Me.QuoteString(obj.DonVi) & "'ORDER BY ST_NHANVIEN.NV_MA")
        End If

        'Cau truy van load don vi len combo donvi
        If obj.ChonBang = 2 Then
            strSQL = ("SELECT X_MA_ FROM Q_CONGNHANSXTHUOCLOAI_DH_NN WHERE X_MA_ <> ' ' GROUP BY X_MA_ ORDER BY X_MA_ ASC ")
        End If

        If obj.ChonBang = 8 Then
            If obj.Khu = "TCT" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND (dbo.ST_DONVI.DV_MA NOT LIKE '%CG%') AND (dbo.ST_DONVI.DV_MA NOT IN ('NV,NV01,NV02, NV03')) AND (NOT (dbo.ST_DONVI.DV_MA = 'BGD')) AND (dbo.ST_DONVI.DV_MA NOT LIKE 'DT%') AND (NOT (dbo.ST_DONVI.X_MA_ = 'KB')) AND (NOT (dbo.ST_DONVI.X_MA_ IS NULL)) ORDER BY ST_NHANVIEN.NV_MA ")
            End If
            If obj.Khu = "KHUA" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_NHANVIEN.DV_MA  NOT LIKE N'B%' AND (dbo.ST_DONVI.DV_MA NOT LIKE '%CG%') AND (dbo.ST_DONVI.DV_MA NOT IN ('NV,NV01,NV02, NV03')) AND (NOT (dbo.ST_DONVI.DV_MA = 'BGD')) AND (dbo.ST_DONVI.DV_MA NOT LIKE 'DT%') AND (NOT (dbo.ST_DONVI.X_MA_ = 'KB')) AND (NOT (dbo.ST_DONVI.X_MA_ IS NULL)) ORDER BY ST_NHANVIEN.NV_MA ")
            End If
            If obj.Khu = "KHUB" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_NHANVIEN.DV_MA   LIKE N'B%' AND (dbo.ST_DONVI.DV_MA NOT LIKE '%CG%') AND (dbo.ST_DONVI.DV_MA NOT IN ('NV,NV01,NV02, NV03')) AND (NOT (dbo.ST_DONVI.DV_MA = 'BGD')) AND (dbo.ST_DONVI.DV_MA NOT LIKE 'DT%') AND (NOT (dbo.ST_DONVI.X_MA_ = 'KB')) AND (NOT (dbo.ST_DONVI.X_MA_ IS NULL)) ORDER BY ST_NHANVIEN.NV_MA ")
            End If
            If obj.Khu = "" Then
                strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND (dbo.ST_DONVI.DV_MA NOT LIKE '%CG%') AND (dbo.ST_DONVI.DV_MA NOT IN ('NV,NV01,NV02, NV03')) AND (NOT (dbo.ST_DONVI.DV_MA = 'BGD')) AND (dbo.ST_DONVI.DV_MA NOT LIKE 'DT%') AND (NOT (dbo.ST_DONVI.X_MA_ = 'KB')) AND (NOT (dbo.ST_DONVI.X_MA_ IS NULL)) ORDER BY ST_NHANVIEN.NV_MA ")

            End If
        End If

        If obj.ChonBang = 9 Then
            strSQL = ("SELECT ST_NHANVIEN.STT AS STT ,ST_NHANVIEN.NV_TEN AS NV_TEN, ST_NHANVIEN.NV_MA AS NV_MA, ST_DONVI.X_MA_ AS X_MA_, ST_DONVI.N_MA AS N_MA, ST_NHANVIEN.DV_MA AS DV_MA, ST_NHANVIEN.NV_NGAYVAO AS NV_NGAYVAO, ST_CONGVIEC.CV_TEN AS CV_TEN FROM ST_NHANVIEN INNER JOIN ST_CONGVIEC ON ST_NHANVIEN.CV_MA = ST_CONGVIEC.CV_MA INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA WHERE ST_CONGVIEC.CV_DOCHAI= 1 AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC) AND ST_NHANVIEN.NV_MA = ' '")
        End If

        If obj.ChonBang = 5 Then
            strSQL = ("SELECT N_MA FROM Q_CONGNHANSXTHUOCLOAI_DH_NN WHERE N_MA <> ' ' GROUP BY N_MA ORDER BY N_MA ASC ")
        End If
        If obj.ChonBang = 6 Then
            strSQL = ("SELECT DV_MA FROM Q_CONGNHANSXTHUOCLOAI_DH_NN WHERE DV_MA <> ' ' GROUP BY DV_MA ORDER BY DV_MA ASC ")
        End If

        If obj.ChonBang = 15 Then
            strSQL = ""
            If (StringType.StrCmp(obj.MANV, "", False) <> 0) Then
                strSQL = (strSQL & " where NV_MA = N'" & Me.QuoteString(obj.MANV) & "'")
            End If
            strSQL = ("select * from ST_NHANVIEN where NV_MA = N'" & Me.QuoteString(obj.MANV) & "' ORDER BY NV_MA ASC")
        End If
        Try
            table = Me.getTableSQL(strSQL)
        Catch exception1 As Exception
            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message)
            table = Nothing
            ProjectData.ClearProjectError()
        End Try
        Return table
    End Function

    Public Function QuoteString(ByVal s As String) As String
        Return s.Replace("'", "''")
    End Function


    Public Function UpdateInfo(ByVal obj As objDocHaiNangNhoc) As Boolean
        Dim flag As Boolean
        Dim strSQL As String = "BEGIN TRANSACTION" & ChrW(13) & ChrW(10)

        If obj.ChonBang = 18 Then
            strSQL = ((((strSQL & "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE" & ChrW(13) & ChrW(10)) & String.Concat(New String() {"update ST_NHANVIEN set STT=N'", Me.QuoteString(obj.STT), "' where NV_MA=N'", Me.QuoteString(obj.MaNV)}) & "'" & ChrW(13) & ChrW(10)) & "if(@@ERROR<>0)" & ChrW(13) & ChrW(10)) & "ROLLBACK TRANSACTION" & ChrW(13) & ChrW(10) & "COMMIT TRANSACTION")
        End If

        Try
            flag = Me.execSQL(strSQL)
        Catch exception1 As Exception
            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message)
            flag = False
            ProjectData.ClearProjectError()
        End Try
        Return flag
    End Function
End Class
