    Public Function DeleteInfo(ByVal obj As objGioCongVuotQua) As Boolean
        Dim strSQL As String = "BEGIN TRANSACTION" & ChrW(13) & ChrW(10)
        strSQL = ((((strSQL & "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE" & ChrW(13) & ChrW(10)) & "DELETE FROM JELL_THONGKEGIOCONGVUOTQUA_TRONGTHANG WHERE YEAR(JELL_THONGKEGIOCONGVUOTQUA_TRONGTHANG.NGAY) = '" & Me.QuoteString(obj.Nam) & "' AND MONTH(JELL_THONGKEGIOCONGVUOTQUA_TRONGTHANG.NGAY)='" & Me.QuoteString(obj.Thang)) & "'" & ChrW(13) & ChrW(10) & "if(@@ERROR<>0)" & ChrW(13) & ChrW(10)) & "ROLLBACK TRANSACTION" & ChrW(13) & ChrW(10) & "COMMIT TRANSACTION")
        Return Me.execSQL(strSQL)
    End Function

    Public Function InsertInfo(ByVal obj As objGioCongVuotQua) As Boolean
        Dim flag As Boolean
        Dim strSQL As String = ""

        strSQL = " INSERT INTO JELL_THONGKEGIOCONGVUOTQUA_TRONGTHANG"
        strSQL += " ("
        strSQL += " NGAY,"
        strSQL += " XUONG,"
        strSQL += " SNGC_MA,"
        strSQL += " SNGC_TEN,"
        strSQL += " SNGC"
        strSQL += " )"
        strSQL += " ("
        strSQL += " SELECT "
        strSQL += " JELL_CHITIET_GIOCONGTANGCA_NGAY.NGAY AS NGAY_VQ,"
        strSQL += " ST_DONVI.X_MA_ AS XUONG,"
        strSQL += " 'ASONGUOI_MA' AS SNGC_MA,"
        strSQL += " N'Số Người--人次' AS SNGC_TEN,"
        strSQL += " SUM(CASE WHEN JELL_CHITIET_GIOCONGTANGCA_NGAY.GC_TANGCA > 4 THEN 1 ELSE 0 END)AS SNGC"
        strSQL += " FROM JELL_CHITIET_GIOCONGTANGCA_NGAY INNER JOIN ST_DONVI"
        strSQL += " ON JELL_CHITIET_GIOCONGTANGCA_NGAY.DV_MA = ST_DONVI.DV_MA"
        strSQL += " WHERE JELL_CHITIET_GIOCONGTANGCA_NGAY.NGAY = '" + obj.Ngay + "'"
        strSQL += " GROUP BY"
        strSQL += " JELL_CHITIET_GIOCONGTANGCA_NGAY.NGAY,"
        strSQL += " ST_DONVI.X_MA_"
        strSQL += " )"
        strSQL += " UNION"
        strSQL += " ("
        strSQL += " SELECT "
        strSQL += " JELL_CHITIET_GIOCONGTANGCA_NGAY.NGAY AS NGAY_VQ,"
        strSQL += " ST_DONVI.X_MA_ AS XUONG,"
        strSQL += " 'BGIOCONG_MA' AS SNGC_MA,"
        strSQL += " N'Giờ Vượt Quá--工時' AS SNGC_TEN,"
        strSQL += " SUM(CASE WHEN JELL_CHITIET_GIOCONGTANGCA_NGAY.GC_TANGCA > 4 "
        strSQL += " THEN JELL_CHITIET_GIOCONGTANGCA_NGAY.GC_TANGCA - 4 ELSE 0 END)AS SNGC"
        strSQL += " FROM JELL_CHITIET_GIOCONGTANGCA_NGAY INNER JOIN ST_DONVI"
        strSQL += " ON JELL_CHITIET_GIOCONGTANGCA_NGAY.DV_MA = ST_DONVI.DV_MA"
        strSQL += " WHERE JELL_CHITIET_GIOCONGTANGCA_NGAY.NGAY = '" + obj.Ngay + "'"
        strSQL += " GROUP BY"
        strSQL += " JELL_CHITIET_GIOCONGTANGCA_NGAY.NGAY,"
        strSQL += " ST_DONVI.X_MA_"
        strSQL += " )"

        Try
            flag = Me.execSQL(strSQL)
        Catch exception1 As Exception
            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message, "Th" & ChrW(244) & "ng b" & ChrW(225) & "o")
            flag = False
            ProjectData.ClearProjectError()
        End Try
        Return flag
    End Function

