    Public Function DeleteInfo(ByVal obj As objQTKhacThuongLC_Thang) As Boolean
        Dim strSQL As String = "BEGIN TRANSACTION" & ChrW(13) & ChrW(10)
        strSQL = ((((strSQL & "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE" & ChrW(13) & ChrW(10)) & "delete from JELL_THONGKEQUETTHESAIQUIDINH_TONG where YEAR(NGAY) = '" & Me.QuoteString(obj.Nam) & "' AND MONTH(NGAY)='" & Me.QuoteString(obj.Thang)) & "'" & ChrW(13) & ChrW(10) & "if(@@ERROR<>0)" & ChrW(13) & ChrW(10)) & "ROLLBACK TRANSACTION" & ChrW(13) & ChrW(10) & "COMMIT TRANSACTION")
        Return Me.execSQL(strSQL)
    End Function

    Public Function InsertInfo(ByVal obj As objQTKhacThuongLC_Thang) As Boolean
        Dim flag As Boolean
        Dim strSQL As String = ""
        strSQL = "INSERT INTO JELL_THONGKEQUETTHESAIQUIDINH_TONG "
        strSQL += "(NGAY,"
        strSQL += "X_MA_,"
        strSQL += "MALC,"
        strSQL += "MAXC,"
        strSQL += "MALCT,"
        strSQL += "MAXCT,"
        strSQL += "LENCA,"
        strSQL += "XUONGCA)"
        strSQL += "SELECT  "
        strSQL += "NGAY = CONVERT(DATETIME,'" + obj.Ngay + "'), "
        strSQL += "JELL_DONVI.X_MA_, "
        strSQL += "MALC = CASE WHEN (CASE WHEN DATEDIFF( MI,'07:15:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN 'VAOSOM'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'07:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) > 0 THEN 1 ELSE 0 END)=1 THEN 'VAOTRE'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIOVAO IS NULL THEN 1 ELSE 0 END)=1 THEN 'VAOKHONGQT' END,"
        strSQL += "MAXC = CASE WHEN (CASE WHEN DATEDIFF( MI,'16:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN 'RASOM'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) > 0 AND DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) <= 39 THEN 1 ELSE 0 END)=1 THEN 'RATRE'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIORA IS NULL THEN 1 ELSE 0 END)=1 THEN 'RAKHONGQT'END,"
        strSQL += "MALCT = CASE WHEN (CASE WHEN DATEDIFF( MI,'07:15:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN N'Vào Sớm--提前'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'07:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) > 0 THEN 1 ELSE 0 END)=1 THEN N'Vào Trể--遲到'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIOVAO IS NULL THEN 1 ELSE 0 END)=1 THEN N'Không QT Vào--未刷' END,"
        strSQL += "MAXCT = CASE WHEN (CASE WHEN DATEDIFF( MI,'16:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN N'Ra Sớm--早退'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) > 0 AND DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) <=39 THEN 1 ELSE 0 END)=1 THEN N'Ra Trể--延遲'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIORA IS NULL THEN 1 ELSE 0 END)=1 THEN N'Không QT Ra--未刷'END,"
        strSQL += "(SUM(CASE WHEN DATEDIFF( MI,'07:15:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) < 0 THEN 1 ELSE 0 END) + "
        strSQL += "SUM(CASE WHEN ST_VAORA.QT_GIOVAO IS NULL THEN 1 ELSE 0 END) + "
        strSQL += "SUM(CASE WHEN DATEDIFF( MI,'07:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) > 0 THEN 1 ELSE 0 END))AS LENCA,"

        strSQL += "(SUM(CASE WHEN DATEDIFF( MI,'16:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) < 0 THEN 1 ELSE 0 END)+"
        strSQL += "SUM(CASE WHEN ST_VAORA.QT_GIORA IS NULL THEN 1 ELSE 0 END) +"
        strSQL += "SUM(CASE WHEN DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) > 0 AND DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) <=39 THEN 1 ELSE 0 END))AS XUONGCA "

        strSQL += "FROM ST_NHANVIEN LEFT JOIN ST_VAORA  "
        strSQL += "ON( ST_NHANVIEN.NV_MA = ST_VAORA.NV_MA  "
        strSQL += "AND ST_VAORA.CA_MA = 'Ca HC'  "
        strSQL += "AND ST_VAORA.QT_NGAY = '" + obj.Ngay + "')  "
        strSQL += "INNER JOIN JELL_DONVI ON ST_NHANVIEN.DV_MA = JELL_DONVI.DV_MA "
        strSQL += "WHERE ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC WHERE TV_NGAYTHOIVIEC <= '" + obj.Ngay + "') "

        strSQL += " AND ST_NHANVIEN.NV_MA IN (SELECT ST_VAORA_MACHINE_NEW.NV_MA FROM ST_VAORA_MACHINE_NEW "
        strSQL += " INNER JOIN ST_GIOQUETTHE ON ST_VAORA_MACHINE_NEW.NV_MA = ST_GIOQUETTHE.NV_MA "
        strSQL += " AND ST_VAORA_MACHINE_NEW.QT_NGAY = ST_GIOQUETTHE.QT_NGAY WHERE ST_VAORA_MACHINE_NEW.QT_NGAY = " + obj.Ngay + " AND ST_GIOQUETTHE.CA_MA = 'Ca HC')"

        strSQL += "AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_GIOQUETTHE WHERE CA_MA <> 'Ca HC' AND ST_GIOQUETTHE.QT_NGAY = '" + obj.Ngay + "') "
        strSQL += "AND ( "
        strSQL += "CASE WHEN DATEDIFF( MI,'07:15:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) < 0 THEN 1 ELSE 0 END+  "
        strSQL += "CASE WHEN ST_VAORA.QT_GIOVAO IS NULL THEN 1 ELSE 0 END + "
        strSQL += "CASE WHEN DATEDIFF( MI,'07:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) > 0 THEN 1 ELSE 0 END + "
        strSQL += "CASE WHEN DATEDIFF( MI,'16:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) < 0 THEN 1 ELSE 0 END  + "
        strSQL += "CASE WHEN ST_VAORA.QT_GIORA IS NULL THEN 1 ELSE 0 END  + "
        strSQL += "CASE WHEN DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) > 0 AND DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) <=39 THEN 1 ELSE 0 END   "
        strSQL += ")>0 "
        strSQL += "AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM IT_THAITHANGTHU7 WHERE  BATDAUTU <= '" + obj.Ngay + "' AND  DENNGAY >= '" + obj.Ngay + "') "
        strSQL += "AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM IT_NUOICONDUOI12THANG WHERE CONVERT(DATETIME,NGAYSANH,103) <= '" + obj.Ngay + "' AND DATEADD(YY,1,CONVERT(DATETIME,NGAYSANH,103)) >= '" + obj.Ngay + "' AND CHONNGAYSANH = 1) "
        strSQL += "AND ST_NHANVIEN.NV_NGAYVAO <= '" + obj.Ngay + "'"
        strSQL += "GROUP BY "
        strSQL += "JELL_DONVI.X_MA_, "
        strSQL += "CASE WHEN (CASE WHEN DATEDIFF( MI,'07:15:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN 'VAOSOM'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'07:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) > 0 THEN 1 ELSE 0 END)=1 THEN 'VAOTRE'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIOVAO IS NULL THEN 1 ELSE 0 END)=1 THEN 'VAOKHONGQT' END,"
        strSQL += "CASE WHEN (CASE WHEN DATEDIFF( MI,'16:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN 'RASOM'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) > 0 AND DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) <=39 THEN 1 ELSE 0 END)=1 THEN 'RATRE'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIORA IS NULL THEN 1 ELSE 0 END)=1 THEN 'RAKHONGQT'END,"
        strSQL += "CASE WHEN (CASE WHEN DATEDIFF( MI,'07:15:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN N'Vào Sớm--提前'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'07:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIOVAO,108) ) > 0 THEN 1 ELSE 0 END)=1 THEN N'Vào Trể--遲到'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIOVAO IS NULL THEN 1 ELSE 0 END)=1 THEN N'Không QT Vào--未刷' END,"
        strSQL += "CASE WHEN (CASE WHEN DATEDIFF( MI,'16:30:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) < 0 THEN 1 ELSE 0 END)=1 THEN N'Ra Sớm--早退'"
        strSQL += "WHEN (CASE WHEN DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) > 0 AND DATEDIFF( MI,'16:45:00', CONVERT(CHAR(8),ST_VAORA.QT_GIORA,108) ) <=39 THEN 1 ELSE 0 END)=1 THEN N'Ra Trể--延遲'"
        strSQL += "WHEN (CASE WHEN ST_VAORA.QT_GIORA IS NULL THEN 1 ELSE 0 END)=1 THEN N'Không QT Ra--未刷'END"
        strSQL += " ORDER BY JELL_DONVI.X_MA_"

        Try
            flag = Me.execSQL(strSQL)
        Catch exception1 As Exception
            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message, "Th" & ChrW(244) & "ng b" & ChrW(225) & "o")
            flag = False
            ProjectData.ClearProjectError()
        End Try
        Return flag
    End Function

