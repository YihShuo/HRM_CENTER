Imports System
Imports System.Data
Imports System.Windows.Forms
Imports Microsoft.VisualBasic.CompilerServices
Public Class clsDTraCuuThongTinThamGiaBH
    Inherits DALSQL
    ' Methods
    Public Function LoadDS(ByVal obj As ObjTraCuuThongTinThamGiaBH) As DataTable
        Dim table As DataTable
        Dim strSQL As String = ""
        If obj.ChonBang = 1 Then
            'strSQL = ("SELECT STT='',ST_NHANVIEN.NV_Ma ,UPPER(NV_Ten)  as NV_Ten,DV_MA,GIOITINH = (CASE WHEN ISNULL(NV_GioiTinh,0) = 1 THEN 'NAM' ELSE N'NỮ' END),")
            'strSQL += "NV_Ngayvao ,NV_CMND ,NV_NGAYSINH = (CASE WHEN ISNULL(NV_NAMSINH,0) = 0  THEN (CONVERT(NVARCHAR(10),ST_NHANVIEN.NV_Ngaysinh,105))"
            'strSQL += " ELSE (LEFT(CONVERT(NVARCHAR(10),ST_NHANVIEN.NV_Ngaysinh,21),4)) END) ,NV_NAMSINH,DT_Ten,QT_Ten,NV_NgayCapCMND,NV_NoiCapCMND"
            'strSQL += ",NV_SoNhaDC  AS NV_DCSoNha_HOKHAU,ST_XAPHUONG_HK.XP_Ten AS XA_HOKHAU,ST_QUANHUYEN_HK.QH_TEN  AS HUYEN_HOKHAU,ST_TINHTHANH_HK.TT_Ten AS TINH_HOKHAU,"
            'strSQL += "ST_XAPHUONG.XP_Ten AS XA_KHAISINH,ST_QUANHUYEN.QH_TEN  AS HUYEN_KHAISINH,ST_TINHTHANH.TT_Ten AS TINH_KHAISINH"
            ' ''========= LẤY MỐI QUAN HỆ CHA/ME/VO/CHONG VOI CHU HO
            'strSQL += ",N'------ THÔNG TIN NHÂN THÂN----------' AS NOI1"
            'strSQL += ",IT_NHANVIENQUANHE_CHA.TENCHAQH,IT_NHANVIENQUANHE_CHA.TENQH_CHUHO AS QHCHUHO1 "
            'strSQL += ",IT_NHANVIENQUANHE_ME.TENMEQH,IT_NHANVIENQUANHE_ME.TENQH_CHUHO AS QHCHUHO2"
            'strSQL += ",IT_NHANVIENQUANHE_CHONG.TENCHONGQH,IT_NHANVIENQUANHE_CHONG.TENQH_CHUHO AS QHCHUHO3"
            'strSQL += ",IT_NHANVIENQUANHE_VO.TENVOQH,IT_NHANVIENQUANHE_VO.TENQH_CHUHO AS QHCHUHO4"

            ' ''========= GOM CHAME/THÂN NHÂN KHÁC
            'strSQL += ",TENCHAMEQH =(CASE WHEN ISNULL(IT_NHANVIENQUANHE_CHA.TENCHAQH,'') <>'' AND ISNULL(IT_NHANVIENQUANHE_ME.TENMEQH,'') <>'' THEN TENCHAQH"
            'strSQL += "        WHEN ISNULL(IT_NHANVIENQUANHE_CHA.TENCHAQH,'') = ''  AND ISNULL(IT_NHANVIENQUANHE_ME.TENMEQH,'')<> ''  THEN TENMEQH"
            'strSQL += "        WHEN ISNULL(IT_NHANVIENQUANHE_CHA.TENCHAQH,'') <>''  AND ISNULL(IT_NHANVIENQUANHE_ME.TENMEQH,'')='' THEN TENCHAQH"
            'strSQL += "        Else '' END)"

            'strSQL += ",THANNHAN_KHAC = (CASE WHEN ISNULL(IT_NHANVIENQUANHE_CHONG.TENCHONGQH,'') <>'' AND ISNULL(IT_NHANVIENQUANHE_VO.TENVOQH,'') <>'' THEN TENCHONGQH"
            'strSQL += "        WHEN ISNULL(IT_NHANVIENQUANHE_CHONG.TENCHONGQH,'') = ''  AND ISNULL(IT_NHANVIENQUANHE_VO.TENVOQH,'')<> ''  THEN TENVOQH"
            'strSQL += "        WHEN ISNULL(IT_NHANVIENQUANHE_CHONG.TENCHONGQH,'') <>''  AND ISNULL(IT_NHANVIENQUANHE_VO.TENVOQH,'')='' THEN TENCHONGQH"
            'strSQL += "        Else '' END)"

            'strSQL += ",N'------ THÔNG TIN CHỦ HỘ----------' AS NOI"
            'strSQL += ",TEN_CHUHO = 	IT_NHANVIENQUANHE_CHUHO.TENCHUHOQH "
            'strSQL += ",GIOITINH_CHUHO = CASE WHEN IT_NHANVIENQUANHE_CHUHO.GIOITINH_QH IS NULL OR IT_NHANVIENQUANHE_CHUHO.GIOITINH_QH  = '' THEN ''"
            'strSQL += " WHEN IT_NHANVIENQUANHE_CHUHO.GIOITINH_QH = 1 THEN N'NAM' ELSE N'NỮ'  END"

            'strSQL += ",DT_CHUHO =  IT_NHANVIENQUANHE_CHUHO.SDT_QH"
            'strSQL += ",SOHK_TAMTRU_CHUHO = IT_NHANVIENQUANHE_CHUHO.SOSOHK_QH "
            'strSQL += ",DIACHI=NV_SoNhaDC,XAPHUONGTHITRAN = ST_XAPHUONG_HK.XP_Ten,HUYEN_QUAN_TPTINH = ST_QUANHUYEN_HK.QH_TEN "
            'strSQL += ",TINH_TP = ST_TINHTHANH_HK.TT_Ten "
            'strSQL += ",IT_NHANVIENQUANHE_CHUHO.NOICAPKHAISINH_QH  AS NOICAPKHAISINH_CHUHO"
            'strSQL += ",IT_NHANVIENQUANHE_CHUHO.SOCMND_QH AS CMND_CHUHO "

            'strSQL += " FROM ST_NHANVIEN  LEFT JOIN ST_DANTOC ON ST_NHANVIEN.DT_MA = ST_DANTOC.DT_Ma "
            'strSQL += " LEFT JOIN ST_QUOCTICH ON ST_NHANVIEN.QT_MA = ST_QUOCTICH.QT_Ma LEFT JOIN ST_XAPHUONG ON ST_NHANVIEN.NV_XaPhuongQQ = ST_XAPHUONG.XP_Ma "
            'strSQL += " AND ST_NHANVIEN.NV_QuanHuyenQQ = ST_XAPHUONG.QH_MA  AND ST_NHANVIEN.NV_TinhQQ = ST_XAPHUONG.TT_MA"
            'strSQL += " LEFT JOIN ST_QUANHUYEN ON ST_NHANVIEN.NV_QuanHuyenQQ = ST_QUANHUYEN.QH_MA "
            'strSQL += " and ST_NHANVIEN.NV_TinhQQ = ST_QUANHUYEN.TT_MA LEFT JOIN ST_TINHTHANH ON ST_NHANVIEN.NV_TinhQQ = ST_TINHTHANH.TT_Ma "
            'strSQL += " LEFT JOIN ST_XAPHUONG  AS ST_XAPHUONG_HK ON ST_NHANVIEN.NV_XaPhuongDC = ST_XAPHUONG_HK.XP_Ma "
            'strSQL += " AND ST_NHANVIEN.NV_QuanHuyenDC = ST_XAPHUONG_HK.QH_MA AND ST_NHANVIEN.NV_TinhDC = ST_XAPHUONG_HK.TT_MA"
            'strSQL += " LEFT JOIN ST_QUANHUYEN  AS  ST_QUANHUYEN_HK ON ST_NHANVIEN.NV_QuanHuyenDC = ST_QUANHUYEN_HK.QH_MA "
            'strSQL += " AND ST_NHANVIEN.NV_TinhDC = ST_QUANHUYEN_HK.TT_MA LEFT JOIN ST_TINHTHANH AS ST_TINHTHANH_HK "
            'strSQL += " ON ST_NHANVIEN.NV_TinhDC = ST_TINHTHANH_HK.TT_Ma "
            ' ''======== MỐI QUAN HỆ: CHA
            'strSQL += " LEFT JOIN ( SELECT IT_NHANVIENQUANHE.NV_MA,IT_NHANVIENQUANHE.TEN_QH AS TENCHAQH,IT_NHANVIENQUANHE.MA_QH,IT_NHANVIENQUANHE.STT"
            'strSQL += ",(CASE WHEN ISNULL(NVQH_NAMSINH,0) = 0  THEN (CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,105)) "
            'strSQL += " ELSE (LEFT(CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,21),4)) END) AS NGAYSINH_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.TENTHUONGGOI,IT_NHANVIENQUANHE.NGHENGHIEP_QH,IT_NHANVIENQUANHE.NOICONGTAC"
            'strSQL += " ,IT_NHANVIENQUANHE.DIACHI_QH,IT_NHANVIENQUANHE.SOCMND_QH,IT_NHANVIENQUANHE.NGAYCAP_QH,IT_NHANVIENQUANHE.TAI_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.SOTHE,IT_NHANVIENQUANHE.COLAMVIEC "
            'strSQL += " ,NVQH_NAMSINH = ISNULL(NVQH_NAMSINH,0),NGAYSINH_QHTT = IT_NHANVIENQUANHE.NGAYSINH_QH "

            'strSQL += ",GIOITINH_QH= ISNULL(IT_NHANVIENQUANHE.GIOITINH_QH,0)"
            'strSQL += ",IT_DANHMUCQUANHECHUHO.TENQH_CHUHO "
            'strSQL += " FROM IT_NHANVIENQUANHE LEFT JOIN IT_DANHMUCQUANHECHUHO ON IT_NHANVIENQUANHE.MA_QHCHUHO = IT_DANHMUCQUANHECHUHO.MAQH_CHUHO"

            'strSQL += " WHERE MA_QH = 'CHA'"
            'strSQL += " ) AS IT_NHANVIENQUANHE_CHA ON ST_NHANVIEN.NV_MA = IT_NHANVIENQUANHE_CHA.NV_MA "
            ' ''======== MỐI QUAN HỆ: MẸ
            'strSQL += " LEFT JOIN( SELECT IT_NHANVIENQUANHE.NV_MA,IT_NHANVIENQUANHE.TEN_QH AS TENMEQH,IT_NHANVIENQUANHE.MA_QH,IT_NHANVIENQUANHE.STT"
            'strSQL += " ,(CASE WHEN ISNULL(NVQH_NAMSINH,0) = 0  THEN (CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,105)) "
            'strSQL += " ELSE (LEFT(CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,21),4)) END) AS NGAYSINH_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.TENTHUONGGOI,IT_NHANVIENQUANHE.NGHENGHIEP_QH,IT_NHANVIENQUANHE.NOICONGTAC"
            'strSQL += " ,IT_NHANVIENQUANHE.DIACHI_QH,IT_NHANVIENQUANHE.SOCMND_QH,IT_NHANVIENQUANHE.NGAYCAP_QH,IT_NHANVIENQUANHE.TAI_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.SOTHE,IT_NHANVIENQUANHE.COLAMVIEC "
            'strSQL += " ,NVQH_NAMSINH = ISNULL(NVQH_NAMSINH,0),NGAYSINH_QHTT = IT_NHANVIENQUANHE.NGAYSINH_QH "

            'strSQL += ",GIOITINH_QH= ISNULL(IT_NHANVIENQUANHE.GIOITINH_QH,0)"
            'strSQL += ",IT_DANHMUCQUANHECHUHO.TENQH_CHUHO "

            'strSQL += " FROM IT_NHANVIENQUANHE LEFT JOIN IT_DANHMUCQUANHECHUHO ON IT_NHANVIENQUANHE.MA_QHCHUHO = IT_DANHMUCQUANHECHUHO.MAQH_CHUHO"
            'strSQL += " WHERE MA_QH = 'ME'"
            'strSQL += " ) AS IT_NHANVIENQUANHE_ME ON ST_NHANVIEN.NV_MA = IT_NHANVIENQUANHE_ME.NV_MA "
            ' ''======== MỐI QUAN HỆ: CHỒNG
            'strSQL += " LEFT JOIN( SELECT IT_NHANVIENQUANHE.NV_MA,IT_NHANVIENQUANHE.TEN_QH AS TENCHONGQH,IT_NHANVIENQUANHE.MA_QH,IT_NHANVIENQUANHE.STT"
            'strSQL += " ,(CASE WHEN ISNULL(NVQH_NAMSINH,0) = 0  THEN (CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,105)) "
            'strSQL += " ELSE (LEFT(CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,21),4)) END) AS NGAYSINH_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.TENTHUONGGOI,IT_NHANVIENQUANHE.NGHENGHIEP_QH,IT_NHANVIENQUANHE.NOICONGTAC"
            'strSQL += " ,IT_NHANVIENQUANHE.DIACHI_QH,IT_NHANVIENQUANHE.SOCMND_QH,IT_NHANVIENQUANHE.NGAYCAP_QH,IT_NHANVIENQUANHE.TAI_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.SOTHE,IT_NHANVIENQUANHE.COLAMVIEC "
            'strSQL += " ,NVQH_NAMSINH = ISNULL(NVQH_NAMSINH,0),NGAYSINH_QHTT = IT_NHANVIENQUANHE.NGAYSINH_QH "

            'strSQL += ",GIOITINH_QH= ISNULL(IT_NHANVIENQUANHE.GIOITINH_QH,0)"
            'strSQL += ",IT_DANHMUCQUANHECHUHO.TENQH_CHUHO "

            'strSQL += " FROM IT_NHANVIENQUANHE LEFT JOIN IT_DANHMUCQUANHECHUHO ON IT_NHANVIENQUANHE.MA_QHCHUHO = IT_DANHMUCQUANHECHUHO.MAQH_CHUHO"
            'strSQL += " WHERE MA_QH = 'CHONG'"
            'strSQL += " ) AS IT_NHANVIENQUANHE_CHONG ON ST_NHANVIEN.NV_MA = IT_NHANVIENQUANHE_CHONG.NV_MA "
            ' ''======== MỐI QUAN HỆ: VỢ
            'strSQL += " LEFT JOIN( SELECT IT_NHANVIENQUANHE.NV_MA,IT_NHANVIENQUANHE.TEN_QH AS TENVOQH,IT_NHANVIENQUANHE.MA_QH,IT_NHANVIENQUANHE.STT"
            'strSQL += " ,(CASE WHEN ISNULL(NVQH_NAMSINH,0) = 0  THEN (CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,105)) "
            'strSQL += " ELSE (LEFT(CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,21),4)) END) AS NGAYSINH_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.TENTHUONGGOI,IT_NHANVIENQUANHE.NGHENGHIEP_QH,IT_NHANVIENQUANHE.NOICONGTAC"
            'strSQL += " ,IT_NHANVIENQUANHE.DIACHI_QH,IT_NHANVIENQUANHE.SOCMND_QH,IT_NHANVIENQUANHE.NGAYCAP_QH,IT_NHANVIENQUANHE.TAI_QH"
            'strSQL += " ,IT_NHANVIENQUANHE.SOTHE,IT_NHANVIENQUANHE.COLAMVIEC "
            'strSQL += " ,NVQH_NAMSINH = ISNULL(NVQH_NAMSINH,0),NGAYSINH_QHTT = IT_NHANVIENQUANHE.NGAYSINH_QH "
            'strSQL += ",GIOITINH_QH= ISNULL(IT_NHANVIENQUANHE.GIOITINH_QH,0)"
            'strSQL += ",IT_DANHMUCQUANHECHUHO.TENQH_CHUHO "

            'strSQL += " FROM IT_NHANVIENQUANHE LEFT JOIN IT_DANHMUCQUANHECHUHO ON IT_NHANVIENQUANHE.MA_QHCHUHO = IT_DANHMUCQUANHECHUHO.MAQH_CHUHO"
            'strSQL += " WHERE MA_QH = 'VO'"
            'strSQL += " ) AS IT_NHANVIENQUANHE_VO ON ST_NHANVIEN.NV_MA = IT_NHANVIENQUANHE_VO.NV_MA "
            ' ''======== MỐI QUAN HỆ: CHỦ HỘ
            'strSQL += " LEFT JOIN( SELECT IT_NHANVIENQUANHE.NV_MA,IT_NHANVIENQUANHE.TEN_QH AS TENCHUHOQH "
            'strSQL += " ,IT_NHANVIENQUANHE.MA_QH AS QHVOI_CHUHO "
            'strSQL += " ,IT_NHANVIENQUANHE.STT ,IT_NHANVIENQUANHE.SOSOHK_QH  ,NOICAPKHAISINH_QH ,SDT_QH "
            'strSQL += " ,NVQH_NAMSINH = ISNULL(NVQH_NAMSINH,0),NGAYSINH_QHTT = IT_NHANVIENQUANHE.NGAYSINH_QH ,GIOITINH_QH= IT_NHANVIENQUANHE.GIOITINH_QH "

            'strSQL += ",IT_NHANVIENQUANHE.SOCMND_QH  ,IT_DANHMUCQUANHECHUHO.TENQH_CHUHO"
            'strSQL += " FROM IT_NHANVIENQUANHE LEFT JOIN IT_DANHMUCQUANHECHUHO ON IT_NHANVIENQUANHE.MA_QHCHUHO = IT_DANHMUCQUANHECHUHO.MAQH_CHUHO "
            'strSQL += " WHERE MA_QHCHUHO = 'CHUHO'"
            'strSQL += " ) AS IT_NHANVIENQUANHE_CHUHO ON ST_NHANVIEN.NV_MA = IT_NHANVIENQUANHE_CHUHO.NV_MA "



            'strSQL += " WHERE ST_NHANVIEN.NV_Ngayvao >='" & obj.TUNGAY & "'"
            'strSQL += " AND ST_NHANVIEN.NV_Ngayvao <='" & obj.DENNGAY & "'"
            'strSQL += " AND ST_NHANVIEN.DV_MA NOT IN (SELECT DV_MA FROM ST_DONVI WHERE ISNULL(DV_TV,0) = 1)"
            'strSQL += " AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC )"
            'strSQL += " AND ST_NHANVIEN.DV_MA NOT LIKE '%CG%'"
            'strSQL += " AND ST_NHANVIEN.DV_MA NOT LIKE '%BGD%'"
            'strSQL += " ORDER BY ST_NHANVIEN.NV_MA"

            strSQL = ("SELECT ROW_NUMBER() over( order by (select ST_NHANVIEN.NV_Ma)) as STT,ST_NHANVIEN.NV_Ma ,UPPER(NV_Ten)  as NV_Ten_NLD")
            strSQL += ",DV_MA"
            strSQL += ",NV_NGAYSINH = (CASE WHEN ISNULL(NV_NAMSINH,0) = 0  THEN (CONVERT(NVARCHAR(10),ST_NHANVIEN.NV_Ngaysinh,103)) ELSE (LEFT(CONVERT(NVARCHAR(10),ST_NHANVIEN.NV_Ngaysinh,21),4)) END)"
            strSQL += ",GIOITINH = (CASE WHEN ISNULL(NV_GioiTinh,0) = 1 THEN 'NAM' ELSE N'NỮ' END)"
            strSQL += ",DT_Ten"
            strSQL += ",NV_CMND"
            strSQL += ",NV_Ngayvao ,NV_NAMSINH,QT_Ten,NV_NgayCapCMND,NV_NoiCapCMND"

            strSQL += ",ST_XAPHUONG.XP_Ten AS XA_KHAISINH"
            strSQL += ",ST_QUANHUYEN.QH_TEN  AS HUYEN_KHAISINH"
            strSQL += ",ST_TINHTHANH.TT_Ten AS TINH_KHAISINH"

            strSQL += ",NV_SoNhaDC  AS NV_DCSoNha_HOKHAU"

            strSQL += ",ST_XAPHUONG_HK.XP_Ten AS XA_HOKHAU"
            strSQL += ",ST_QUANHUYEN_HK.QH_TEN  AS HUYEN_HOKHAU"
            strSQL += ",ST_TINHTHANH_HK.TT_Ten AS TINH_HOKHAU"


            strSQL += ",IT_NHANVIENQUANHE.TEN_QH AS TENQUANHE"
            strSQL += ",NV_NGAYSINH_QH = (CASE WHEN ISNULL(IT_NHANVIENQUANHE.NVQH_NAMSINH ,0) = 0 THEN (CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH ,103)) ELSE (LEFT(CONVERT(NVARCHAR(10),IT_NHANVIENQUANHE.NGAYSINH_QH,21),4)) END) "
            strSQL += ",MOIQH_CHUHO = IT_DANHMUCQUANHECHUHO.TENQH_CHUHO "
            strSQL += ",GT_QUANHE = CASE WHEN ISNULL(IT_NHANVIENQUANHE.GIOITINH_QH  ,0) = 1  THEN 'NAM' ELSE N'NỮ' END "
            strSQL += ",IT_NHANVIENQUANHE.NOICAPKHAISINH_QH "
            strSQL += ",IT_NHANVIENQUANHE .SOCMND_QH"
            strSQL += ",TENCHUHO= CASE WHEN UPPER(IT_NHANVIENQUANHE.MA_QHCHUHO) ='CHUHO' THEN IT_NHANVIENQUANHE .TEN_QH  ELSE '' END"
            strSQL += ",IT_NHANVIENQUANHE.SOSOHK_QH ,IT_NHANVIENQUANHE.DIACHI_QH "
            strSQL += ",IT_DANHMUCQUANHE.TEN_QH  AS MOIQHNLD"

            strSQL += " FROM ST_NHANVIEN  LEFT JOIN ST_DANTOC ON ST_NHANVIEN.DT_MA = ST_DANTOC.DT_Ma"
            strSQL += " LEFT JOIN ST_QUOCTICH ON ST_NHANVIEN.QT_MA = ST_QUOCTICH.QT_Ma "

            strSQL += " LEFT JOIN ST_XAPHUONG ON ST_NHANVIEN.NV_XaPhuongQQ = ST_XAPHUONG.XP_Ma "
            strSQL += " AND ST_NHANVIEN.NV_QuanHuyenQQ = ST_XAPHUONG.QH_MA  AND ST_NHANVIEN.NV_TinhQQ = ST_XAPHUONG.TT_MA "

            strSQL += " LEFT JOIN ST_QUANHUYEN ON ST_NHANVIEN.NV_QuanHuyenQQ = ST_QUANHUYEN.QH_MA "
            strSQL += " AND ST_NHANVIEN.NV_TinhQQ = ST_QUANHUYEN.TT_MA "

            strSQL += " LEFT JOIN ST_TINHTHANH ON ST_NHANVIEN.NV_TinhQQ = ST_TINHTHANH.TT_Ma "

            strSQL += " LEFT JOIN ST_XAPHUONG  AS ST_XAPHUONG_HK ON ST_NHANVIEN.NV_XaPhuongDC = ST_XAPHUONG_HK.XP_Ma "
            strSQL += " AND ST_NHANVIEN.NV_QuanHuyenDC = ST_XAPHUONG_HK.QH_MA "
            strSQL += " AND ST_NHANVIEN.NV_TinhDC = ST_XAPHUONG_HK.TT_MA "

            strSQL += " LEFT JOIN ST_QUANHUYEN  AS  ST_QUANHUYEN_HK ON ST_NHANVIEN.NV_QuanHuyenDC = ST_QUANHUYEN_HK.QH_MA "
            strSQL += " AND ST_NHANVIEN.NV_TinhDC = ST_QUANHUYEN_HK.TT_MA"

            strSQL += " LEFT JOIN ST_TINHTHANH AS ST_TINHTHANH_HK  ON ST_NHANVIEN.NV_TinhDC = ST_TINHTHANH_HK.TT_Ma "
            strSQL += " LEFT JOIN IT_NHANVIENQUANHE ON ST_NHANVIEN.NV_Ma = IT_NHANVIENQUANHE.NV_MA "
            strSQL += " LEFT JOIN IT_DANHMUCQUANHECHUHO ON IT_NHANVIENQUANHE.MA_QHCHUHO = IT_DANHMUCQUANHECHUHO.MAQH_CHUHO "
            strSQL += " LEFT JOIN IT_DANHMUCQUANHE  ON IT_NHANVIENQUANHE.MA_QH = IT_DANHMUCQUANHE.MA_QH "

            strSQL += " WHERE ST_NHANVIEN.NV_Ngayvao >='" & obj.TUNGAY & "'"
            strSQL += " AND ST_NHANVIEN.NV_Ngayvao <='" & obj.DENNGAY & "'"
            'strSQL += " AND ST_NHANVIEN.DV_MA NOT IN (SELECT DV_MA FROM ST_DONVI WHERE ISNULL(DV_TV,0) = 1)"
            'strSQL += " AND ST_NHANVIEN.NV_MA NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC )"
            strSQL += " AND ST_NHANVIEN.DV_MA NOT LIKE '%CG%'"
            strSQL += " AND ST_NHANVIEN.DV_MA NOT LIKE '%BGD%'"
            strSQL += " ORDER BY ST_NHANVIEN.NV_MA"

        End If
        Try
            table = Me.getTableSQL(strSQL)
        Catch exception1 As Exception
            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message)
            table = Nothing

            ProjectData.ClearProjectError()
        End Try
        Return table
    End Function
End Class
