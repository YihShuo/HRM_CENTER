        strSQL = ((String.Concat(New String() {strSQL, Me.QuoteString(obj.CauTruyVan)}) & ChrW(13) & ChrW(10) & "if(@@ERROR<>0)" & ChrW(13) & ChrW(10)) & "ROLLBACK TRANSACTION" & ChrW(13) & ChrW(10) & "COMMIT TRANSACTION")
