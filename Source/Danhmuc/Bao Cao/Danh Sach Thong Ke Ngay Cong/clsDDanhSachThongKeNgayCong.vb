Imports Microsoft.VisualBasic.CompilerServices
Imports System
Imports System.Data
Imports System.Windows.Forms
Public Class clsDDanhSachThongKeNgayCong
    Inherits DALSQL
    Public Function LoadDL(ByVal obj As objDanhSachThongKeNgayCong) As DataTable
        Dim table As DataTable
        Dim strSQL As String = ""

        If obj.ChonBang = 1 Then
            strSQL = "SELECT STT= 0,ST_NHANVIEN.NV_Ma,"
            strSQL = strSQL + " ST_NHANVIEN.NV_Ten,"
            strSQL = strSQL + " ST_NHANVIEN.DV_MA,"
            strSQL = strSQL + " TONGSONGAYCONGTT = SUM (ISNULL(ST_GIOQUETTHE.CC_GIOBINHTHUONG,0))/8,"
            strSQL = strSQL + " SONGAYP = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'P'  AND DATEPART(DW,QT_NGAY)<> 1 AND CC_GIOBINHTHUONG = 0 THEN CC_SOGIONGHI ELSE 0 END)/8 ,"
            strSQL = strSQL + " SONGAYR = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'R'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYNO = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'NO'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYQS = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'QS'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYP1 = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'P1'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYOM = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'OM'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 ,"
            strSQL = strSQL + " SONGAYCO = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'CO'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 ,"
            strSQL = strSQL + " SONGAYTS = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'TS'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYTS1 = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'TS1'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYST = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'ST'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 ,"
            strSQL = strSQL + " SONGAYKTHAI = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'KTHAI'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYDS = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'DS' AND DATEPART(DW,QT_NGAY)<> 1  THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYRO = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'RO'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 ,"
            strSQL = strSQL + " SONGAYTNLD = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'TNLD'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 ,"
            strSQL = strSQL + " SONGAYDQ = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'DQ'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 ,"
            strSQL = strSQL + " SONGAYNO1 = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'NO1' AND DATEPART(DW,QT_NGAY)<> 1  THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYKHHGD = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'KHHGD'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " TONGNGHICOLUONG =   SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'P'  AND DATEPART(DW,QT_NGAY)<> 1 AND CC_GIOBINHTHUONG = 0 THEN CC_SOGIONGHI ELSE 0 END)/8 "
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'R'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'NO'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'QS'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'P1'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " TONGNGHIKHONGLUONG = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'OM'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 "
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'CO'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 "
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'TS'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'TS1'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'ST' AND DATEPART(DW,QT_NGAY)<> 1  THEN CC_SOGIONGHI ELSE 0 END)/8 "
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'KTHAI' AND DATEPART(DW,QT_NGAY)<> 1  THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'DS'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'RO'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 "
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'TNLD'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 "
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'DQ'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8 "
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'NO1'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " + SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'KHHGD'  AND DATEPART(DW,QT_NGAY)<> 1 THEN CC_SOGIONGHI ELSE 0 END)/8,"
            strSQL = strSQL + " SONGAYO = SUM(CASE WHEN NOT ST_GIOQUETTHE.NP_MA IS NULL AND NP_MA = 'O'  AND DATEPART(DW,QT_NGAY)<> 1 AND CC_SOGIONGHI > 0 THEN CC_SOGIONGHI ELSE 0 END)/8"
            strSQL = strSQL + " FROM ST_NHANVIEN LEFT JOIN ST_GIOQUETTHE ON ST_NHANVIEN.NV_Ma =  ST_GIOQUETTHE.NV_MA "
            strSQL = strSQL + " AND ST_GIOQUETTHE.QT_NGAY >=  '" & obj.TUNGAY & "'"
            strSQL = strSQL + " AND ST_GIOQUETTHE.QT_NGAY <= '" & obj.DENNGAY & "'"
            strSQL = strSQL + " AND ST_NHANVIEN.NV_Ngayvao <= '" & obj.DENNGAY & "'"
            strSQL = strSQL + " INNER JOIN ST_DONVI ON ST_NHANVIEN.DV_MA = ST_DONVI.DV_MA AND DV_LocBB = 0"
            strSQL = strSQL + " WHERE ST_NHANVIEN.NV_Ma NOT IN (SELECT NV_MA FROM ST_NHANVIENTHOIVIEC )"
            strSQL = strSQL + " AND ST_NHANVIEN.DV_MA NOT LIKE '%CG%'"
            strSQL = strSQL + " AND ST_NHANVIEN.DV_MA NOT IN ('BGD','BGDX')"
            strSQL = strSQL + " GROUP BY ST_NHANVIEN.NV_Ma,"
            strSQL = strSQL + " ST_NHANVIEN.DV_MA,"
            strSQL = strSQL + " ST_NHANVIEN.NV_Ten"
            strSQL = strSQL + " ORDER BY ST_NHANVIEN.dv_MA "
        End If
        Try
            table = Me.getTableSQL(strSQL)
        Catch exception1 As Exception

            ProjectData.SetProjectError(exception1)
            Dim exception As Exception = exception1
            MessageBox.Show(exception.Message)
            table = Nothing
            ProjectData.ClearProjectError()
        End Try
        Return table
    End Function
    Public Function GoiThuTucLoadDS(ByVal m_sSP_Name As String, ByVal m_listpar As ArrayList) As DataTable
        Return Me.getDatasetProcedure(m_sSP_Name, m_listpar).Tables(0)
    End Function
    Public Function QuoteString(ByVal s As String) As String
        Return s.Replace("'", "''")
    End Function
End Class
