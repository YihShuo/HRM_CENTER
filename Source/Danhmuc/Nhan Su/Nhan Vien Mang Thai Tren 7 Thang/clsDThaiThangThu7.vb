    Public Function DeleteInfo(ByVal obj As objThaiThangThu7) As Boolean
        Dim strSQL As String = "BEGIN TRANSACTION" & ChrW(13) & ChrW(10)
        strSQL = ((((strSQL & "SET TRANSACTION ISOLATION LEVEL SERIALIZABLE" & ChrW(13) & ChrW(10)) & "delete from IT_THAITHANGTHU7 where NV_MA=N'" & Me.QuoteString(obj.ID) & "'AND BATDAUTU = '" & Me.QuoteString(obj.NGAY)) & "'" & ChrW(13) & ChrW(10) & "if(@@ERROR<>0)" & ChrW(13) & ChrW(10)) & "ROLLBACK TRANSACTION" & ChrW(13) & ChrW(10) & "COMMIT TRANSACTION")
        Return Me.execSQL(strSQL)
    End Function

    Public Function IsDeleteOK(ByVal obj As objThaiThangThu7) As Boolean
        Dim strSQL As String = ("select NV_MA from IT_THAITHANGTHU7 where NV_MA=N'" & Me.QuoteString(obj.MaNV) & "' ")
        If (Me.getTableSQL(strSQL).Rows.Count > 0) Then
            Return False
        End If
        Return True
    End Function

